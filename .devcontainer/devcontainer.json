{
  "name": "AntiBot Lab · Streamlit Research",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt pytest",
